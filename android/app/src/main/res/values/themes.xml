<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns everything inside the window. This theme only keeps the system
      bars transparent and the launch background matching the dark UI.
    -->
    <style name="Theme.Sonora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sonora_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
