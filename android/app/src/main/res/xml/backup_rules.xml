<?xml version="1.0" encoding="utf-8"?>
<!--
  Credentials live in Keystore-wrapped files that cannot be restored on another
  device, so backing them up is pointless and risky. Nothing is backed up.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
